APP_NAME=TechOps Kubernetes
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8080
FRONTEND_URL=http://127.0.0.1:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stderr
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=techops_learning
DB_USERNAME=techops_learning
SESSION_DRIVER=database
SESSION_COOKIE=techops_kubernetes_session
SESSION_DOMAIN=null
SESSION_PATH=/
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8080
QUEUE_CONNECTION=database
CACHE_STORE=database
OPERATIONS_CACHE_STORE=redis
OPERATIONS_DASHBOARD_TTL=30
OPERATIONS_CATALOG_TTL=300
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=techops_learning:
MAIL_MAILER=log
MAIL_FROM_ADDRESS=admin@techops.local
MAIL_FROM_NAME=TechOps Learning
ADMIN_EMAIL=admin@techops.local
ADMIN_NAME=TechOps Learning Administrator
